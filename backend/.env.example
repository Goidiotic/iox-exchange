NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5174

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace-with-your-access-secret
JWT_REFRESH_SECRET=replace-with-your-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=15
APIHOME_KEY=replace-with-apihome-key

M3_BASE_URL=https://api.m3wallet.example
M3_API_KEY=replace-with-m3-api-key
M3_MERCHANT_WALLET_ID=replace-with-merchant-wallet-id
WALLET_SYNC_ENCRYPTION_KEY=replace-with-32-byte-encryption-key

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
